{
  "name": "selftest",
  "description": "All Startup_* / World_* checks of the mod (the ones Kydl.GameProbe runs) pass inside a TestLab world",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "kc.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "kc.hubOpen"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "kc.hubClose"
    },
    {
      "do": "wait",
      "seconds": 6
    },
    {
      "do": "hook",
      "name": "kc.selftest",
      "notContains": "FAIL",
      "contains": "PASS",
      "label": "InGameTests (KC-01 .. KC-05)"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "KydlCore"
    }
  ]
}
