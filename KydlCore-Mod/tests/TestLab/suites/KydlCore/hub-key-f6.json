{
  "name": "hub-key-f6",
  "description": "F6 (default key) toggles the hub like a real key press",
  "timeout": 60,
  "steps": [
    {
      "do": "pressKey",
      "key": "F6",
      "frames": 3
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "kc.hubIsOpen",
        "args": {},
        "expect": true
      },
      "timeout": 5
    },
    {
      "do": "pressKey",
      "key": "F6",
      "frames": 3
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "kc.hubIsOpen",
        "args": {},
        "expect": false
      },
      "timeout": 5
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "KydlCore"
    }
  ]
}